{
  "name": "time-deposit-kata-node",
  "version": "1.0.0",
  "description": "",
  "author": "Sohail Yar Khan (Ikigai)",
  "license": "MIT",
  "main": "src/index.ts",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "start": "ts-node src/index.ts",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns integration",
    "test:integration": "jest integration",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.js",
    "generate:api": "openapi-typescript src/adapters/in/http/openapi.yaml --output src/adapters/in/http/generated/openapi.ts",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "lint:api": "redocly lint",
    "test:coverage": "jest --coverage"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "express": "^4.21.2",
    "express-openapi-validator": "^5.3.9",
    "pg": "^8.13.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@babel/core": "7.19.1",
    "@babel/preset-env": "7.19.1",
    "@babel/preset-typescript": "7.18.6",
    "@biomejs/biome": "2.5.15",
    "@redocly/cli": "1.34.20",
    "@testcontainers/postgresql": "^10.16.0",
    "@types/express": "4.17.21",
    "@types/jest": "^29.1.1",
    "@types/node": "18.7.18",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "dependency-cruiser": "16.10.4",
    "jest": "29.0.3",
    "lefthook": "2.1.16",
    "nodemon": "^2.0.20",
    "openapi-typescript": "6.7.6",
    "supertest": "^7.0.0",
    "testcontainers": "^10.16.0",
    "ts-node": "^10.9.1",
    "typescript": "4.8.3"
  },
  "keywords": [],
  "resolutions": {
    "@types/express": "4.17.21",
    "@types/express-serve-static-core": "^4.19.6"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/tests/**",
      "!src/**/generated/**",
      "!src/index.ts",
      "!src/config.ts",
      "!src/TimeDeposit.ts",
      "!src/TimeDepositCalculator.ts"
    ],
    "coverageReporters": [
      "text",
      "html"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 85,
        "branches": 50,
        "functions": 85,
        "lines": 85
      },
      "./src/domain/": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      },
      "./src/application/": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      }
    }
  }
}
